{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "picker",
    "blackscreen",
    "snipper",
    "pinned-snip"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "global-shortcut:default",
    "clipboard-manager:default",
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
